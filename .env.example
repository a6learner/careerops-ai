CAREEROPS_ENV=local
CAREEROPS_SERVICE_NAME=careerops-api
CAREEROPS_DATABASE_URL=postgresql+asyncpg://careerops:careerops@localhost:5432/careerops
CAREEROPS_REDIS_URL=redis://localhost:6379/0
CAREEROPS_DASHBOARD_CACHE_TTL_SECONDS=30
CAREEROPS_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CAREEROPS_PARSE_RUN_STALE_AFTER_SECONDS=300
CAREEROPS_PARSE_RUN_RECOVERY_BATCH_SIZE=100
CAREEROPS_ANALYSIS_RUN_STALE_AFTER_SECONDS=300
CAREEROPS_ANALYSIS_RUN_RECOVERY_BATCH_SIZE=100
CAREEROPS_EMBEDDING_RUN_STALE_AFTER_SECONDS=300
CAREEROPS_EMBEDDING_RUN_RECOVERY_BATCH_SIZE=100
CAREEROPS_LLM_PROVIDER=fake
CAREEROPS_LLM_MODEL=openai/gpt-oss-20b
CAREEROPS_LLM_BASE_URL=https://api.groq.com/openai/v1
CAREEROPS_LLM_API_KEY=
CAREEROPS_LLM_TIMEOUT_SECONDS=30
CAREEROPS_LLM_MAX_ATTEMPTS=2
CAREEROPS_LLM_RETRY_BASE_DELAY_SECONDS=0.25
CAREEROPS_LLM_MAX_OUTPUT_TOKENS=1500
CAREEROPS_RUN_EMBEDDING_EVAL=0
CAREEROPS_RUN_EMBEDDING_HOLDOUT=0
CAREEROPS_GEMINI_API_KEY=
CAREEROPS_LOG_LEVEL=INFO
CAREEROPS_JWT_SECRET=change-me-in-local-development-secret-32-bytes-minimum
CAREEROPS_ACCESS_TOKEN_EXPIRE_MINUTES=30
